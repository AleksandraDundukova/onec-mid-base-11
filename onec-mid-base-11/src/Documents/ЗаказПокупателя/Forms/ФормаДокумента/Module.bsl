#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПересчитатьТаблицы(Команда)
	ПересчитатьТаблицыНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДЗ_ПослеВопросаПересчёта(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПересчитатьТаблицыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	Если ТекущиеДанные.Скидка = 0 Тогда
		КоэффициентСкидки = 1;
	Иначе
		КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьТаблицыНаСервере()
	
	// Пересчёт строк
	Для Каждого Строка Из Объект.Товары Цикл
		Если Строка.Цена = 0 Тогда
			Строка.Сумма = 0;
		Иначе
			Строка.Сумма = Строка.Цена * Строка.Количество * (1 - Объект.СогласованнаяСкидка / 100);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из Объект.Услуги Цикл
		Если Строка.Цена = 0 Тогда
			Строка.Сумма = 0;
		Иначе
			Строка.Сумма = Строка.Цена * Строка.Количество * (1 - Объект.СогласованнаяСкидка / 100);
		КонецЕсли;
	КонецЦикла;
	
	// === ИТОГОВАЯ СУММА ДОКУМЕНТА ===
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти